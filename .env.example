APP_ENV=development
DEV_AUTH_ENABLED=true
APP_SECRET=replace-with-a-long-random-development-secret
DATABASE_URL=postgresql+psycopg://games:YOUR_LOCAL_PASSWORD@127.0.0.1:55439/games
SUPABASE_URL=
GEMINI_API_KEY=
TAROT_MODEL=gemini-3.5-flash-lite
TAROT_API_TIER=free
TAROT_DAILY_LIMIT=100

# apps/web/.env.local (local frontend only)
# BACKEND_INTERNAL_URL=http://127.0.0.1:8217
# DEV_AUTH_ENABLED=true
# NEXT_PUBLIC_DEV_AUTH=true
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Hosted environments must disable both development-auth flags.
