APP_ENV=development
DEV_AUTH_ENABLED=true
APP_SECRET=replace-with-a-long-random-development-secret
DATABASE_URL=postgresql+psycopg://games:YOUR_LOCAL_PASSWORD@127.0.0.1:55439/games
SUPABASE_URL=
GEMINI_API_KEY=
TAROT_MODEL=gemini-4-hydrogen
TAROT_API_TIER=free
TAROT_DAILY_LIMIT=100
# Enable only providers/modes that have passed the real reading-quality gate.
TAROT_PROVIDER_ORDER=["gemini"]
GROQ_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
TAROT_GROQ_MODES=[]
TAROT_CLOUDFLARE_MODES=[]

# apps/web/.env.local (local frontend only)
# BACKEND_INTERNAL_URL=http://127.0.0.1:8217
# DEV_AUTH_ENABLED=true
# NEXT_PUBLIC_DEV_AUTH=true
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Hosted environments must disable both development-auth flags.
