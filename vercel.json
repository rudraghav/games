{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["bom1"],
  "services": {
    "web": {"root": "apps/web", "framework": "nextjs", "bindings": [{"type": "service", "service": "backend", "format": "url", "env": "BACKEND_INTERNAL_URL"}]},
    "backend": {"root": "backend", "framework": "fastapi", "entrypoint": "main:app"}
  },
  "rewrites": [{"source": "/(.*)", "destination": {"service": "web"}}]
}
